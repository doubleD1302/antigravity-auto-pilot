<Window x:Class="AntigravityAutoPilot.UI.DangerousCommandDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cảnh Báo Lệnh Nguy Hiểm - Antigravity Auto Pilot"
        Icon="/auto_pilot_logo.png"
        Height="540" Width="720"
        MinHeight="450" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#0b0f19"
        Foreground="#f3f4f6"
        FontFamily="Segoe UI, Segoe UI Variable, Inter, sans-serif">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="#1f2937" />
            <Setter Property="Foreground" Value="#f9fafb" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#374151" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Block Button -->
        <Style x:Key="DangerBlockButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#b91c1c" />
            <Setter Property="BorderBrush" Value="#ef4444" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#dc2626" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Success Approve Button -->
        <Style x:Key="SuccessApproveButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#15803d" />
            <Setter Property="BorderBrush" Value="#22c55e" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#16a34a" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Copy Action Button -->
        <Style x:Key="CopyButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#1e293b" />
            <Setter Property="BorderBrush" Value="#38bdf8" />
            <Setter Property="Foreground" Value="#38bdf8" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header Banner -->
            <RowDefinition Height="Auto" />
            <!-- Command Area -->
            <RowDefinition Height="*" />
            <!-- Context Expander -->
            <RowDefinition Height="Auto" />
            <!-- Action Buttons Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Banner -->
        <Border Grid.Row="0" Background="#2c0b0e" BorderBrush="#ef4444" BorderThickness="1.5" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Warning Icon -->
                <TextBlock Grid.Column="0" Text="🚨" FontSize="32" Margin="0,0,14,0" VerticalAlignment="Center" />

                <!-- Text Info -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="CẢNH BÁO: PHÁT HIỆN LỆNH NGUY HIỂM!" FontSize="16" FontWeight="Bold" Foreground="#f87171" Margin="0,0,0,4" />
                    <TextBlock x:Name="TxtWarningSubtitle" Text="Auto Pilot đã chặn tự động thực thi do phát hiện câu lệnh có nguy cơ phá hủy hệ thống. Bạn có thể sao chép lệnh, kiểm tra kỹ trước khi quyết định Duyệt hoặc Chặn." FontSize="12.5" Foreground="#d1d5db" TextWrapping="Wrap" />
                    
                    <!-- Keyword & Action Badge -->
                    <WrapPanel Margin="0,8,0,0">
                        <Border Background="#450a0a" BorderBrush="#991b1b" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Từ khóa nguy hiểm: " FontSize="11.5" Foreground="#9ca3af" />
                                <TextBlock x:Name="TxtDangerousKeyword" Text="rm -rf" FontSize="11.5" FontWeight="Bold" Foreground="#fca5a5" />
                            </StackPanel>
                        </Border>

                        <Border Background="#172554" BorderBrush="#1e40af" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Hành động: " FontSize="11.5" Foreground="#9ca3af" />
                                <TextBlock x:Name="TxtActionName" Text="Run Command" FontSize="11.5" FontWeight="Bold" Foreground="#93c5fd" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Command Display Box -->
        <Border Grid.Row="1" Background="#111827" BorderBrush="#1f2937" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Box Header with Title and Copy Button -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💻 TOÀN BỘ CÂU LỆNH PHÁT HIỆN" FontSize="12" FontWeight="Bold" Foreground="#e5e7eb" />
                        <TextBlock Text=" (có thể bôi đen hoặc bấm copy)" FontSize="11.5" Foreground="#9ca3af" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Copy Button -->
                    <Button x:Name="BtnCopyCommand" Grid.Column="1" Style="{StaticResource CopyButton}" Click="BtnCopyCommand_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtCopyIcon" Text="📋" Margin="0,0,6,0" />
                            <TextBlock x:Name="TxtCopyLabel" Text="Sao chép lệnh" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Command TextBox -->
                <TextBox x:Name="TxtFullCommand"
                         Grid.Row="1"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Cascadia Code, Courier New, monospace"
                         FontSize="13.5"
                         Background="#030712"
                         Foreground="#38bdf8"
                         BorderBrush="#374151"
                         BorderThickness="1"
                         Padding="10" />
            </Grid>
        </Border>

        <!-- 3. Context Details Expander -->
        <Expander Grid.Row="2" Header="🔍 Xem toàn bộ ngữ cảnh thẻ giao diện IDE (Context)" Foreground="#9ca3af" FontSize="12" Margin="0,0,0,14">
            <Border Background="#030712" BorderBrush="#1f2937" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,6,0,0" MaxHeight="140">
                <TextBox x:Name="TxtFullContext"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas, monospace"
                         FontSize="11.5"
                         Background="Transparent"
                         Foreground="#9ca3af"
                         BorderThickness="0" />
            </Border>
        </Expander>

        <!-- 4. Action Buttons Footer -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Status hint -->
            <TextBlock Grid.Column="0" Text="Nhấn Chặn để dừng tool ngay lập tức, hoặc Duyệt để tiếp tục thực thi." FontSize="11.5" Foreground="#6b7280" VerticalAlignment="Center" />

            <!-- Button Chặn -->
            <Button x:Name="BtnBlock" Grid.Column="1" Style="{StaticResource DangerBlockButton}" Margin="0,0,12,0" Padding="18,10" Click="BtnBlock_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🛑" Margin="0,0,8,0" FontSize="14" />
                    <TextBlock Text="Chặn (Tạm dừng tool)" />
                </StackPanel>
            </Button>

            <!-- Button Duyệt -->
            <Button x:Name="BtnApprove" Grid.Column="2" Style="{StaticResource SuccessApproveButton}" Padding="18,10" Click="BtnApprove_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✅" Margin="0,0,8,0" FontSize="14" />
                    <TextBlock Text="Duyệt (Tiếp tục tool)" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
